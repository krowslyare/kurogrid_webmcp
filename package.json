{
  "name": "kurogrid-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public-safe WebMCP challenge implementation for Kurogrid.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run test:unit && npm run test:db && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:db": "npx supabase test db",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "supabase:start": "npx supabase start",
    "supabase:reset": "npx supabase db reset --local --yes",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "demo:provision": "node --env-file-if-exists=.env.local scripts/provision-demo.mjs",
    "demo:verify-hosted": "node --env-file=.env.hosted.local scripts/verify-hosted-demo.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
